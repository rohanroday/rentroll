# Copy this file to .env.local and fill in your own values. Never share .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The address of this app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Any long random text. Protects the daily reminder job.
CRON_SECRET=

# The Gmail account that sends reminders, and its 16-letter App Password.
# On this computer, emails are only printed in the terminal until these are filled in.
GMAIL_USER=
GMAIL_APP_PASSWORD=
