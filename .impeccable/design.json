      "css": ".ds-field{display:flex;flex-direction:column;gap:5px;font-size:.875rem;font-weight:700;color:var(--ink);}.ds-input{width:100%;min-height:48px;padding:8px 14px;background:var(--white);color:var(--ink);border:1px solid var(--edge);border-radius:var(--radius-sm);font:inherit;font-size:1rem;font-weight:400;transition:border-color .15s,box-shadow .15s;}.ds-input:hover{border-color:var(--green-3);}.ds-input:focus-visible{outline:none;border-color:var(--green-3);box-shadow:0 0 0 3px var(--mint);}.ds-input::placeholder{color:#5e756c;}"
