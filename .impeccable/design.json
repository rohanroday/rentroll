      "css": ".ds-btn-destructive{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:48px;padding:8px 20px;border:1.5px solid transparent;border-radius:var(--radius-sm);font:inherit;font-weight:700;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s,transform .1s;background:var(--white);border-color:var(--ink);color:var(--ink);}.ds-btn-destructive:hover{background:var(--slate-bg);}.ds-btn-destructive:focus-visible{outline:3px solid var(--green-3);outline-offset:2px;}.ds-btn-destructive:active{transform:translateY(1px);}"
