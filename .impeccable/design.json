      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Row and supporting actions, including Mark Paid.",
      "html": "<button class=\"ds-btn-secondary\">Mark Paid</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:48px;padding:8px 20px;border:1.5px solid transparent;border-radius:var(--radius-sm);font:inherit;font-weight:700;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s,transform .1s;background:var(--white);border-color:var(--green-2);color:var(--green);}.ds-btn-secondary:hover{background:var(--mint-2);}.ds-btn-secondary:focus-visible{outline:3px solid var(--green-3);outline-offset:2px;}.ds-btn-secondary:active{transform:translateY(1px);}"
